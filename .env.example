AIRFLOW_API_SECRET_KEY=5b853c37145e3e70e6cd9ff898846595f002c0a19bc7b439
AIRFLOW_JWT_SECRET=66346c73c685ca77b02cf2ee61f5dd2a16a16f62b9244144

