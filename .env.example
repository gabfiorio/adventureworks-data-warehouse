# Copie para .env:  cp .env.example .env
# Valores apenas para ambiente LOCAL de estudo. Nao use em producao.
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
AIRFLOW_LOAD_EXAMPLES=false
AIRFLOW_LOGGING_LEVEL=WARNING
AIRFLOW_PARALLELISM=4
AIRFLOW_MAX_ACTIVE_TASKS_PER_DAG=2

# Banco de metadados do Airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow_local_password
POSTGRES_DB=airflow

# Origem OLTP (AdventureWorks) e destino (Data Warehouse)
AW_PASSWORD=aw_local_password

# Chaves do Airflow (geradas para uso local; para gerar outra Fernet:
# docker run --rm apache/airflow:3.3.1 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
